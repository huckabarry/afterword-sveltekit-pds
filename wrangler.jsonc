{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "afterword-sveltekit-pds",
	"compatibility_date": "2026-03-22",
	"compatibility_flags": ["nodejs_compat", "nodejs_als"],
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		"ATPROTO_REPO": "did:plc:vt4k6d3e5rjw65cuzaf3nufq",
		"STANDARD_SITE_LOGIN_IDENTIFIER": "afterword.blog",
		"STANDARD_SITE_IDENTIFIER": "afterword.blog",
		"STANDARD_SITE_PDS_URL": "https://eurosky.social",
		"STANDARD_SITE_PUBLICATION_URL": "https://afterword.blog",
		"LOWVELOCITY_STANDARD_SITE_LOGIN_IDENTIFIER": "lowvelocity.org",
		"LOWVELOCITY_STANDARD_SITE_IDENTIFIER": "lowvelocity.org",
		"LOWVELOCITY_STANDARD_SITE_PDS_URL": "https://enoki.us-east.host.bsky.network",
		"LOWVELOCITY_STANDARD_SITE_PUBLICATION_URL": "https://lowvelocity.org",
		"LOWVELOCITY_STANDARD_SITE_NAME": "Low Velocity",
		"LOWVELOCITY_STANDARD_SITE_DESCRIPTION": "Urban planning, housing, transportation, and civic life.",
		"LOWVELOCITY_STANDARD_SITE_ICON_URL": "https://lowvelocity.org/favicon.png"
	},
	"d1_databases": [
		{
			"binding": "D1_DATABASE",
			"database_name": "d1-database",
			"database_id": "61f9c95d-c74d-4490-8fb8-f5737289a08a"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2_BUCKET",
			"bucket_name": "afterword"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"routes": [],
	"main": "src/shutdown-worker.js"
}
